# Caderninho — modelo de configuração.
#
# Copie para .env, preencha e ajuste as permissões:
#   cp .env.example .env && chmod 600 .env && chown www-data:www-data .env
#
# O .env fica na raiz da instalação, UM NÍVEL ACIMA de public/, portanto fora
# do alcance do servidor web. Ele nunca deve ser versionado (ver .gitignore).

# --- Banco de dados ---------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=caderninho
DB_USER=caderninho
# Gere uma senha forte com: openssl rand -hex 24
DB_PASS=

# Alternativa: DSN completa do PDO. Se preenchida, tem precedência sobre
# DB_HOST/DB_PORT/DB_NAME.
# DB_DSN=pgsql:host=localhost;port=5432;dbname=caderninho

# --- Acesso ao aplicativo ---------------------------------------------------
# Hash bcrypt da senha de login (nunca a senha em texto puro). Gere com:
#   php -r 'echo password_hash(readline("Senha: "), PASSWORD_DEFAULT), "\n";'
# O valor começa com $2y$ e contém cifrões. O parser do app não faz
# interpolação: mantenha o valor literal, sem aspas e sem variáveis.
APP_PASSWORD_HASH=
